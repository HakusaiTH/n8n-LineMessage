{
  "name": "n8n-nodes-line-message",
  "version": "1.0.0",
  "description": "n8n nodes for LINE Messaging API: send text, stickers, images, videos, and more via n8n workflows.",
  "keywords": [
    "n8n-community-node-package",
    "line",
    "line-bot",
    "line-messaging-api",
    "chatbot"
  ],
  "license": "MIT",
  "homepage": "https://github.com/HakusaiTH/n8n-LineMessage",
  "author": {
    "name": "Phoovadet Noobdev",
    "email": "phoovadetnoobdev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HakusaiTH/n8n-LineMessage.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LineApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LineSendText/LineSendText.node.js",
      "dist/nodes/SendSticker/LineSendSticker.node.js",
      "dist/nodes/SendImage/LineSendImage.node.js",
      "dist/nodes/SendVideo/LineSendVideo.node.js",
      "dist/nodes/SendAudio/LineSendAudio.node.js",
      "dist/nodes/SendLocation/LineSendLocation.node.js",
      "dist/nodes/SendImagemap/LineSendImagemap.node.js",
      "dist/nodes/SendTemplate/LineSendTemplate.node.js",
      "dist/nodes/SendFlex/LineSendFlex.node.js",
      "dist/nodes/Webhook/LineWebhook.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
